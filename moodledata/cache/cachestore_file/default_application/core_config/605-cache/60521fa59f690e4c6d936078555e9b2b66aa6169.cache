.custom-header-menu {
    position: absolute;
    top: 0;
    right: 40px;
    z-index: 3000;
    display: flex;
    gap: 30px;
    height: 60px;
    align-items: center;
}

/* Estilo do texto igual à referência */
.custom-header-menu a {
    color: #2f6f8f !important;
    font-weight: 600;
    text-decoration: none;
    font-size: 15px;
}

.custom-header-menu a:hover {
    border-bottom: 2px solid #2f6f8f;
    padding-bottom: 3px;
}

/* A navbar padrão fica por baixo */
.navbar {
    height: 60px;
    position: relative;
    z-index: 2000;
}
