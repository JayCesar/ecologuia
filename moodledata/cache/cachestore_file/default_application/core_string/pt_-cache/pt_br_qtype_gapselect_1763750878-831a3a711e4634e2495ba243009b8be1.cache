a:23:{s:19:"addmorechoiceblanks";s:42:"Espaços em branco para mais {no} opções";s:6:"answer";s:8:"Resposta";s:7:"choices";s:8:"Opções";s:7:"choicex";s:12:"Opção {no}";s:28:"combinedcontrolnamegapselect";s:13:"menu suspenso";s:34:"combinedcontrolnamegapselectplural";s:15:"menus suspensos";s:15:"correctansweris";s:27:"A resposta correta é: {$a}";s:16:"errorblankchoice";s:59:"Por favor, verifique as opções: Opção {$a} está vazia.";s:18:"errormissingchoice";s:172:"Verifique o texto da questão: {$a} não foi encontrado entre as opções! Somente números com as respostas definidas de escolha podem ser usados como espaços reservados.";s:12:"errornoslots";s:114:"O texto da questão deve conter espaços reservados, como [[1]] para mostrar onde devem ir as palavras que faltam.";s:22:"errorquestiontextblank";s:47:"Você deve digitar algum texto para a questão.";s:5:"group";s:5:"Grupo";s:26:"pleaseputananswerineachbox";s:46:"Por favor, coloque uma resposta em cada caixa.";s:10:"pluginname";s:33:"Selecionar as palavras que faltam";s:15:"pluginname_help";s:493:"As questões para selecionar palavras que faltam exigem que o respondente selecione as respostas corretas nos menus suspensos. [[1]], [[2]], [[3]], ... são usados como espaços reservados no texto da questão, com as respostas corretas definidas como opções de resposta 1, 2, 3, ... respectivamente. Opções extras de respostas podem ser adicionadas para tornar a questão mais difícil. As opções de respostas podem ser agrupadas para controlar as disponíveis em cada menu de opções.";s:15:"pluginname_link";s:23:"question/type/gapselect";s:16:"pluginnameadding";s:60:"Adicionando uma questão de seleção de palavras que faltam";s:17:"pluginnameediting";s:57:"Editando uma selação de palavras que faltam na questão";s:17:"pluginnamesummary";s:91:"As palavras que faltam no texto da questão são preenchidas utilizando os menus suspensos.";s:16:"privacy:metadata";s:77:"O plugin Selecionar as palavras que faltam não armazena nenhum dado pessoal.";s:7:"shuffle";s:10:"Embaralhar";s:14:"tagsnotallowed";s:65:"{$a->tag} não é permitido. (Apenas {$a->allowed} é permitida.)";s:19:"tagsnotallowedatall";s:67:"{$a->tag} não é permitido. (Código HTML não é permitido aqui.)";}